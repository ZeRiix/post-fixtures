			"\t\t\t${1:Ticket}.Entity.update({ state: payload }),",
			"\t\t\t${1:Ticket}.${8:SoldFlag}.append(payload),",
			"\t\t\tapplyFact(payload),",
			"\t\t);",
			"\t},",
