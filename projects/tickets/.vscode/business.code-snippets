	"DuploJS: Aggregate workflow": {
		"prefix": "iaf",
		"scope": "typescript",
		"description": "Agrégat pur avec createWorkflow; demandes de commit déclaratives",
		"body": [
			"import * as DInvocation from \"@duplojs/lang/invocation\";",
			"import * as DCommon from \"@duplojs/lang/common\";",
			"import * as DEither from \"@duplojs/lang/either\";",
			"import { ${2:SellTicketFact}, type ${3:Ticket} } from \"../entities\";",
			"",
			"export const ${1:sellTicket} = DInvocation.createWorkflow(",
			"\t({ commit }) => function *(",
			"\t\tparams: {",
			"\t\t\tentity: ${3:Ticket}.Entity & ${3:Ticket}.${4:AvailableFlag};",
			"\t\t\t$5",
			"\t\t},",
			"\t) {",
			"\t\tconst updatedEntity = DCommon.pipe(",
			"\t\t\t${2:SellTicketFact}.run(params),",
			"\t\t\tDEither.unwrapRight,",
			"\t\t);",
			"",
			"\t\tyield *commit(\"${6:ticket}\", updatedEntity);",
			"\t\treturn updatedEntity;",
			"\t},",
			");",
			"$0"
		]
	},
